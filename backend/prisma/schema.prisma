generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== Destinations & Attractions (Student 1) =====
model Destination {
  id          String       @id @default(uuid())
  name        String
  country     String
  city        String
  description String?
  attractions Attraction[]
  createdAt   DateTime     @default(now())
}

model Attraction {
  id            String      @id @default(uuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])
  name          String
  category      String
  openingHours  String?
  entryFee      Float?
  visitDuration Int?
  latitude      Float?
  longitude     Float?
  isAccessible  Boolean     @default(true)
  createdAt     DateTime    @default(now())
}